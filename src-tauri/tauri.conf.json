{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guppy",
  "version": "1.0.0",
  "identifier": "dev.rollando.guppy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Guppy",
        "width": 820,
        "height": 640,
        "minWidth": 600,
        "minHeight": 480,
        "decorations": false,
        "shadow": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "YouTube downloader and audio converter",
    "publisher": "Roland Matuz",
    "windows": {
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" }
    }
  }
}
